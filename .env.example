# Скопіюй цей файл у .env і встав свої значення. .env не потрапляє в git.

# Публічна адреса сайту (без слеша в кінці). Поки домен не куплено — плейсхолдер.
SITE_URL=https://example.com

# Ключі для допоміжних скриптів дослідження (research/*.py). Для збірки сайту не потрібні.
SERPER_API_KEY=
TAVILY_API_KEY=
