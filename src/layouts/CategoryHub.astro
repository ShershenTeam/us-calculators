---
/**
 * Category hub (docs/03 §4): intro, all published calculators of the category
 * (including alsoIn), optional subgroups, FAQ, breadcrumbs.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import CalculatorCard from '@/components/CalculatorCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import TableWrap from '@/components/TableWrap.astro';
import { registry } from '@/lib/registry';
import { jsonLd, plainText } from '@/lib/seo';
import type { Category } from '@/data/categories';

interface Props {
  category: Category;
  entry: CollectionEntry<'categories'>;
}
const { category, entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${category.slug}/`;
const calculators = registry.byCategory(category.id, 'en');

const grouped = category.subgroups
  ? [
      ...category.subgroups
        .map((s) => ({ name: s.name, items: calculators.filter((c) => c.subgroup === s.id) }))
        .filter((g) => g.items.length > 0),
      { name: 'Other', items: calculators.filter((c) => !c.subgroup) },
    ].filter((g) => g.items.length > 0)
  : [{ name: '', items: calculators }];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: category.name, url: path },
];
const faqLd = jsonLd.faqPage(entry.data.faq.map((f) => ({ q: f.q, a: plainText(f.a) })));
---

<Base title={entry.data.title} description={entry.data.description} {path} ogImage={`/og/hub-${category.slug}.png`}>
  <Fragment slot="head">
    <JsonLd data={[jsonLd.breadcrumbs(crumbs), faqLd]} />
  </Fragment>

  <Breadcrumbs crumbs={crumbs} />
  <header class="mt-3 mb-8">
    <h1 class="text-[2rem] md:text-[2.75rem] font-semibold">{entry.data.h1}</h1>
    <p class="text-[1.05rem] md:text-lg text-muted mt-2.5 max-w-[62ch] leading-relaxed">{entry.data.intro}</p>
    <p class="rule-label mt-5">
      {calculators.length} calculator{calculators.length === 1 ? '' : 's'}
    </p>
  </header>

  {
    grouped.map((g) => (
      <section class="mb-10">
        {g.name && <h2 class="text-xl font-semibold mb-4">{g.name}</h2>}
        {g.items.length === 0 ? (
          <p class="text-muted">Calculators for this category are being prepared.</p>
        ) : (
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0">
            {g.items.map((c, i) => (
              <li>
                <CalculatorCard href={`/${c.slugs.en}/`} name={c.name} blurb={c.blurb} index={i} />
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <div class="prose mt-12">
    <Content components={{ table: TableWrap }} />
  </div>

  <FAQ items={entry.data.faq} />
</Base>
