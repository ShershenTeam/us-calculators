---
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import JsonLd from '@/components/JsonLd.astro';
import { jsonLd } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  updated?: Date;
  noindex?: boolean;
}
const { title, description, path, h1, updated, noindex = false } = Astro.props;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: h1, url: path },
];
---

<Base {title} {description} {path} {noindex} mainClass="max-w-3xl">
  <Fragment slot="head">
    <JsonLd data={jsonLd.breadcrumbs(crumbs)} />
  </Fragment>
  <Breadcrumbs crumbs={crumbs} />
  <article class="prose mt-3">
    <h1 class="text-[2rem] md:text-[2.75rem] font-semibold mb-5">{h1}</h1>
    <slot />
    {
      updated && (
        <p class="text-sm text-muted mt-10 pt-4 border-t border-border">
          Last updated:{' '}
          <time datetime={updated.toISOString().slice(0, 10)}>
            {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </p>
      )
    }
  </article>
</Base>
