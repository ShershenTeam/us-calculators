---
import type { CalculatorLink } from '@/lib/registry';
import CalculatorCard from '@/components/CalculatorCard.astro';

interface Props {
  items: CalculatorLink[];
  heading?: string;
}
const { items, heading = 'Related calculators' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="related-heading" class="mt-12">
      <h2 id="related-heading" class="text-2xl md:text-[1.75rem] font-semibold mb-4">{heading}</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0">
        {items.map((c, i) => (
          <li>
            <CalculatorCard href={c.url} name={c.name} blurb={c.blurb} index={i} />
          </li>
        ))}
      </ul>
    </section>
  )
}
