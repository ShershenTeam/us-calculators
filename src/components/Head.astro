---
/**
 * Everything inside <head>: title, description, canonical (never with params),
 * hreflang, Open Graph / Twitter, icons, manifest, theme-color, global CSS.
 * docs/07-seo-checklist.md A1, B2.
 */
import '@/styles/global.css';
import { site } from '@/data/site';
import { abs } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  /** Path with leading and trailing slash, e.g. `/gravel-calculator/`. */
  path: string;
  /** hreflang alternates: `{ 'en-US': '/x/', 'es-US': '/es/y/', 'x-default': '/x/' }` */
  alternates?: Record<string, string>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  locale?: 'en-US' | 'es-US';
}

const {
  title,
  description,
  path,
  alternates = {},
  ogImage = '/og/default.png',
  ogType = 'website',
  noindex = false,
  locale = 'en-US',
} = Astro.props;

if (title.length > 60) throw new Error(`Head: title longer than 60 chars on ${path}: "${title}"`);
if (description.length < 120 || description.length > 155) {
  throw new Error(`Head: description must be 120–155 chars on ${path} (is ${description.length})`);
}
if (!path.startsWith('/') || !path.endsWith('/')) throw new Error(`Head: path must start and end with "/": ${path}`);

const canonical = abs(path);
const fullTitle = title;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{Object.entries(alternates).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={abs(href)} />)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={locale.replace('-', '_')} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={abs(ogImage)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(ogImage)} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content={site.themeColor.light} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={site.themeColor.dark} />
<meta name="color-scheme" content="light dark" />
<link rel="sitemap" href="/sitemap-index.xml" />
<slot />
