---
import type { Crumb } from '@/lib/seo';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 m-0 p-0 list-none">
    {
      crumbs.map((c, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {last ? (
              <span aria-current="page" class="text-text">{c.name}</span>
            ) : (
              <a href={c.url} class="text-muted hover:text-accent no-underline hover:underline">{c.name}</a>
            )}
            {!last && <span aria-hidden="true">›</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
