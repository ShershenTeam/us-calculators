---
import type { Crumb } from '@/lib/seo';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-0.5 m-0 p-0 list-none font-mono tracking-wide uppercase text-[0.6875rem]">
    {
      crumbs.map((c, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li class="flex items-center gap-2">
            {last ? (
              <span aria-current="page" class="text-muted">{c.name}</span>
            ) : (
              <a href={c.url} class="text-muted no-underline hover:text-accent">{c.name}</a>
            )}
            {!last && <span aria-hidden="true" class="text-rule">/</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
