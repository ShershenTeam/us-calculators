---
/**
 * Zero-JS search form. Submits to /search/ where Pagefind UI is mounted.
 * Always visible in the header, also used on 404 (docs/03 §3).
 */
interface Props {
  id?: string;
  size?: 'sm' | 'lg';
  autofocus?: boolean;
}
const { id = 'site-search', size = 'sm', autofocus = false } = Astro.props;
const h = size === 'lg' ? 'h-14' : 'h-11';
const pad = size === 'lg' ? 'pl-12 pr-4 text-[1.0625rem]' : 'pl-10 pr-3 text-base';
const iconLeft = size === 'lg' ? 'left-4' : 'left-3';
---

<form role="search" action="/search/" method="get" class="group flex w-full items-stretch">
  <label for={id} class="sr-only">Search calculators</label>
  <div class="relative flex-1 min-w-0">
    <svg
      class={`pointer-events-none absolute ${iconLeft} top-1/2 -translate-y-1/2 text-muted group-focus-within:text-accent transition-colors`}
      width={size === 'lg' ? 20 : 17}
      height={size === 'lg' ? 20 : 17}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path>
    </svg>
    <input
      id={id}
      name="q"
      type="search"
      inputmode="search"
      autocomplete="off"
      placeholder="Search calculators…"
      autofocus={autofocus}
      class={`w-full ${h} ${pad} rounded-l-field border border-r-0 border-border bg-surface text-text placeholder:text-muted/80 focus:border-accent focus:outline-none transition-colors`}
    />
  </div>
  <button
    type="submit"
    class={`${h} ${size === 'lg' ? 'px-6 text-[0.95rem]' : 'px-3 sm:px-4 text-sm'} shrink-0 rounded-r-field bg-accent text-accent-contrast font-semibold tracking-wide hover:bg-accent-strong focus-visible:outline-offset-0 transition-colors`}
    aria-label="Search"
  >
    <span class={size === 'lg' ? '' : 'hidden sm:inline'} aria-hidden="true">Search</span>
    {
      size === 'sm' && (
        <svg class="sm:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" />
        </svg>
      )
    }
  </button>
</form>
