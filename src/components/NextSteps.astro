---
import type { CalculatorLink } from '@/lib/registry';

interface Props {
  items: CalculatorLink[];
  heading?: string;
}
const { items, heading = 'What to calculate next' } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label={heading} class="mt-8">
      <p class="rule-label mb-3">{heading}</p>
      <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
        {items.map((c) => (
          <li>
            <a
              href={c.url}
              class="group inline-flex items-center gap-2 min-h-12 px-4 rounded-field border border-border bg-surface text-text font-medium text-[0.9375rem] no-underline hover:border-accent hover:text-accent hover:shadow-card transition"
            >
              {c.name}
              <span aria-hidden="true" class="text-accent-line transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
