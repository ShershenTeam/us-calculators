---
import type { FaqItem } from '@/lib/seo';

interface Props {
  items: FaqItem[];
  heading?: string;
  id?: string;
}
const { items, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section aria-labelledby={`${id}-heading`} class="mt-12">
  <h2 id={`${id}-heading`} class="text-2xl md:text-[1.75rem] font-semibold mb-4">{heading}</h2>
  <div class="divide-y divide-border rounded-card border border-border bg-surface overflow-hidden">
    {
      items.map((f, i) => (
        <details class="group" open={i === 0}>
          <summary class="cursor-pointer list-none px-4 py-3.5 min-h-12 flex items-start justify-between gap-4 hover:bg-surface-2/60 transition-colors">
            <h3 class="text-[1.0625rem] font-medium m-0 leading-snug font-sans">{f.q}</h3>
            <span
              aria-hidden="true"
              class="mt-0.5 shrink-0 grid place-items-center h-6 w-6 rounded-full border border-border text-muted text-base leading-none transition-transform duration-200 group-open:rotate-45 group-open:border-accent group-open:text-accent"
            >
              +
            </span>
          </summary>
          <div class="px-4 pb-4 pt-0 text-[0.9688rem] leading-relaxed text-muted max-w-[68ch]" set:html={f.a} />
        </details>
      ))
    }
  </div>
</section>
