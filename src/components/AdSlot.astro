---
/**
 * Reserved-height ad slot (docs/03 §9, docs/06 §6): no layout shift when the ad loads.
 * No network code until the AdSense account exists; the box is a labelled placeholder.
 */
interface Props {
  id: string;
  /** Height reserved on mobile / desktop. */
  mobile?: number;
  desktop?: number;
}
const { id, mobile = 250, desktop = 280 } = Astro.props;
---

<aside
  data-ad-slot={id}
  class="ad-slot my-6 rounded-card border border-dashed border-border bg-surface-2 text-muted text-xs flex items-center justify-center"
  style={`--ad-h-mobile:${mobile}px;--ad-h-desktop:${desktop}px`}
  aria-label="Advertisement"
>
  <span>Advertisement</span>
</aside>

<style>
  .ad-slot { min-height: var(--ad-h-mobile); }
  @media (min-width: 768px) { .ad-slot { min-height: var(--ad-h-desktop); } }
</style>
