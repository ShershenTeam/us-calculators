---
import { site, serviceLinks } from '@/data/site';
import { registry } from '@/lib/registry';

const groups = registry.categoriesWithContent('en').filter((g) => g.calculators.length > 0);
const year = new Date().getFullYear();
const copyright = site.foundedYear === year ? `${year}` : `${site.foundedYear}–${year}`;
---

<footer class="mt-20 border-t border-border bg-surface-sunken text-sm">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-10 md:grid-cols-[1.1fr_2fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-[6px]" />
        <span class="font-display text-xl font-semibold tracking-tight">{site.name}</span>
      </div>
      <p class="mt-3 text-muted max-w-[34ch] leading-relaxed">{site.tagline}</p>
      <p class="rule-label mt-6">Est. {site.foundedYear}</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      <nav aria-label="Categories">
        <h2 class="rule-label mb-3">Calculators</h2>
        <ul class="grid gap-2 list-none m-0 p-0">
          {
            groups.map((g) => (
              <li>
                <a href={`/${g.category.slug}/`} class="text-text no-underline hover:text-accent">
                  {g.category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="About this site">
        <h2 class="rule-label mb-3">The site</h2>
        <ul class="grid gap-2 list-none m-0 p-0">
          {
            serviceLinks.map((l) => (
              <li>
                <a href={l.href} class="text-text no-underline hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-5 text-muted grid gap-2 md:grid-cols-2 text-[0.8125rem] leading-relaxed">
      <p class="m-0">
        © {copyright} {site.name}. Results are estimates for planning; confirm quantities with your supplier or a professional.
      </p>
      <p class="m-0 md:text-right">
        Formulas are tested against official sources — see <a href="/methodology/">Methodology</a>.
      </p>
    </div>
  </div>
</footer>
