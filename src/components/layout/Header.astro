---
/**
 * Header (docs/03 §3): wordmark · always-visible search · category menu.
 * Desktop: category links with hover/focus mega-menus. Mobile: <details> burger.
 * No JS. Design: docs/11-design-system.md §4 — masthead of a printed manual.
 */
import { site, nav } from '@/data/site';
import { registry } from '@/lib/registry';
import SearchBox from '@/components/SearchBox.astro';

const groups = registry.categoriesWithContent('en').filter((g) => g.calculators.length > 0);
const primary = groups.filter((g) => (nav.headerCategoryIds as readonly string[]).includes(g.category.id));
const more = groups.filter((g) => !(nav.headerCategoryIds as readonly string[]).includes(g.category.id));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/92 backdrop-blur-md supports-[backdrop-filter]:bg-bg/80">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-center gap-3 h-16">
      <a
        href="/"
        class="flex items-center gap-2.5 no-underline text-text shrink-0 group"
        aria-label={`${site.name} home`}
      >
        <img src="/favicon.svg" alt="" width="30" height="30" class="rounded-[7px] shadow-card" />
        <span class="hidden sm:inline font-display text-[1.3rem] font-semibold tracking-tight group-hover:text-accent transition-colors">
          {site.name}
        </span>
      </a>

      <div class="flex-1 max-w-xl"><SearchBox /></div>

      <details class="md:hidden relative">
        <summary
          class="list-none cursor-pointer h-12 w-12 -mr-2 grid place-items-center rounded-lg text-text hover:bg-surface-2 transition-colors"
          aria-label="Menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav
          aria-label="Categories"
          class="absolute right-0 top-14 w-[min(92vw,22rem)] rounded-card border border-border bg-surface shadow-float p-2 max-h-[75vh] overflow-y-auto"
        >
          {
            groups.map((g) => (
              <details class="rounded-field">
                <summary class="list-none cursor-pointer flex items-center justify-between min-h-12 px-3 font-semibold">
                  {g.category.name}
                  <span aria-hidden="true" class="text-accent-line">›</span>
                </summary>
                <ul class="list-none m-0 p-0 pb-2 border-l border-border ml-4">
                  {g.calculators.slice(0, 8).map((c) => (
                    <li>
                      <a href={`/${c.slugs.en}/`} class="block px-4 py-2.5 text-text no-underline hover:bg-surface-2 rounded-r-field">
                        {c.name}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href={`/${g.category.slug}/`} class="block px-4 py-2.5 font-medium text-accent">
                      All {g.category.shortName} →
                    </a>
                  </li>
                </ul>
              </details>
            ))
          }
        </nav>
      </details>
    </div>

    <nav aria-label="Categories" class="hidden md:block">
      <ul class="flex gap-0.5 list-none m-0 p-0 -mx-2">
        {
          primary.map((g) => (
            <li class="group relative">
              <a
                href={`/${g.category.slug}/`}
                class="inline-flex items-center h-11 px-3 text-text no-underline text-[0.9rem] font-medium rounded-t-field border-b-2 border-transparent hover:border-accent group-focus-within:border-accent transition-colors"
              >
                {g.category.shortName}
              </a>
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
                <div class="w-[min(90vw,40rem)] rounded-card border border-border bg-surface shadow-float p-5 ruled-top">
                  <p class="rule-label m-0 mb-3">{g.category.shortName}</p>
                  <p class="m-0 mb-3 text-sm text-muted max-w-prose">{g.category.blurb}</p>
                  <ul class="grid grid-cols-2 gap-x-6 list-none m-0 p-0">
                    {g.calculators.slice(0, 10).map((c) => (
                      <li class="border-b border-border/60 last:border-0">
                        <a href={`/${c.slugs.en}/`} class="block py-2 text-text no-underline text-[0.925rem] hover:text-accent">
                          {c.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={`/${g.category.slug}/`} class="inline-block mt-4 font-medium text-sm">
                    All {g.category.name} →
                  </a>
                </div>
              </div>
            </li>
          ))
        }
        {
          more.length > 0 && (
            <li class="group relative">
              <button
                type="button"
                class="inline-flex items-center h-11 px-3 text-[0.9rem] font-medium rounded-t-field border-b-2 border-transparent hover:border-accent"
                aria-haspopup="true"
              >
                More
                <span aria-hidden="true" class="ml-1 text-[0.7em] text-muted">▾</span>
              </button>
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50">
                <ul class="w-64 rounded-card border border-border bg-surface shadow-float p-2 list-none m-0">
                  {more.map((g) => (
                    <li>
                      <a href={`/${g.category.slug}/`} class="block px-3 py-2.5 text-text no-underline hover:bg-surface-2 rounded-field">
                        {g.category.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
