---
/**
 * Home: search + categories + popular calculators (docs/03 §2).
 * The full basic calculator planned for the home page arrives with the Math cluster (stage F).
 */
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import SearchBox from '@/components/SearchBox.astro';
import CalculatorCard from '@/components/CalculatorCard.astro';
import { registry } from '@/lib/registry';
import { jsonLd } from '@/lib/seo';
import { site } from '@/data/site';

const allGroups = registry.categoriesWithContent('en');
const groups = allGroups.filter((g) => g.calculators.length > 0);
const upcoming = allGroups.filter((g) => g.calculators.length === 0).map((g) => g.category.name);
const published = registry.published('en');
const title = `Free Calculators, Converters & Quick Answers | ${site.name}`;
const description =
  'Fast, mobile-first calculators for construction materials, work hours, percentages, unit conversions and dates. Every formula is tested against sources.';

const promises = [
  {
    label: 'Checked against primary sources',
    body: 'Unit factors from NIST, labor rules from the U.S. Department of Labor, material data from manufacturers. Every worked example becomes an automated test.',
    href: '/methodology/',
    linkText: 'How we test',
  },
  {
    label: 'Built for the phone in your hand',
    body: 'The calculator is the first thing on the screen, the result updates as you type, and you can copy, share or print it.',
  },
  {
    label: 'No sign-up, no paywall',
    body: 'Free to use. Ads pay for the site; they never sit between the title and the calculator.',
    href: '/editorial-policy/',
    linkText: 'Editorial policy',
  },
];
---

<Base {title} {description} path="/">
  <Fragment slot="head">
    <JsonLd data={[jsonLd.organization(), jsonLd.webSite()]} />
  </Fragment>

  {/* Hero: an opened title page of the manual. */}
  <section class="relative py-10 md:py-16 text-center">
    <p class="rise rise-1 font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-muted">
      {site.name} · United States edition
    </p>
    <h1 class="rise rise-2 mt-4 text-[2.25rem] leading-[1.06] md:text-[3.5rem] font-semibold max-w-[18ch] mx-auto">
      Calculators that give the answer before you finish typing
    </h1>
    <p class="rise rise-2 text-[1.05rem] md:text-lg text-muted mt-4 max-w-[52ch] mx-auto leading-relaxed">
      {site.tagline} Results update as you type, work on your phone, and show exactly how they were calculated.
    </p>
    <div class="rise rise-3 max-w-xl mx-auto mt-7"><SearchBox id="home-search" size="lg" /></div>
    <p class="rise rise-3 mt-4 text-xs text-muted">
      {published.length > 0 ? `${published.length} calculator${published.length === 1 ? '' : 's'} published` : 'First calculators publishing now'} · every formula sourced and tested
    </p>
  </section>

  <section aria-labelledby="categories-heading" class="mt-6">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="categories-heading" class="text-2xl md:text-[1.75rem] font-semibold m-0">Browse by category</h2>
      {upcoming.length > 0 && <p class="m-0 text-xs text-muted hidden sm:block">In preparation: {upcoming.join(', ')}</p>}
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0">
      {
        groups.map(({ category, calculators }, i) => (
          <li class="sheet rounded-card border border-border bg-surface p-5 pt-6 transition hover:shadow-card">
            <p class="rule-label mb-2">{String(i + 1).padStart(2, '0')} · {category.shortName}</p>
            <h3 class="text-[1.2rem] font-semibold m-0">
              <a href={`/${category.slug}/`} class="text-text no-underline hover:text-accent">
                {category.name}
              </a>
            </h3>
            <p class="text-sm text-muted mt-1.5 mb-3 leading-snug">{category.blurb}</p>
            <ul class="list-none m-0 p-0 divide-y divide-border/70 border-t border-border/70">
              {calculators.slice(0, 5).map((c) => (
                <li>
                  <a href={`/${c.slugs.en}/`} class="block py-2 text-[0.9375rem] text-text no-underline hover:text-accent">
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
            {calculators.length > 5 && (
              <a href={`/${category.slug}/`} class="inline-block mt-3 text-sm font-medium">
                All {category.shortName} →
              </a>
            )}
          </li>
        ))
      }
    </ul>
    {upcoming.length > 0 && <p class="text-xs text-muted mt-4 sm:hidden">In preparation: {upcoming.join(', ')}.</p>}
  </section>

  {
    published.length > 0 && (
      <section aria-labelledby="popular-heading" class="mt-14">
        <h2 id="popular-heading" class="text-2xl md:text-[1.75rem] font-semibold mb-4">Popular calculators</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 list-none m-0 p-0">
          {published.slice(0, 8).map((c, i) => (
            <li>
              <CalculatorCard href={`/${c.slugs.en}/`} name={c.name} blurb={c.blurb} index={i} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="promises-heading" class="mt-16 border-t-2 border-border pt-8">
    <h2 id="promises-heading" class="sr-only">Why trust these calculators</h2>
    <ul class="grid gap-8 md:grid-cols-3 list-none m-0 p-0">
      {
        promises.map((p, i) => (
          <li>
            <p class="rule-label mb-2.5">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="text-[1.0625rem] font-semibold m-0 font-sans">{p.label}</h3>
            <p class="m-0 mt-1.5 text-sm text-muted leading-relaxed">
              {p.body}
              {p.href && (
                <>
                  {' '}
                  <a href={p.href}>{p.linkText}</a>.
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
